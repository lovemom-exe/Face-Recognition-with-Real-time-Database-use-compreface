APP_ENV=development
APP_NAME=Face Attendance System
DEBUG=true

# SQLite fallback for local business-logic testing.
DATABASE_URL=sqlite:///backend_attendance.db
# PostgreSQL local via docker-compose.postgres.yml:
# DATABASE_URL=postgresql+psycopg2://face_attendance:face_attendance_password@127.0.0.1:55432/face_attendance

JWT_SECRET_KEY=change-me-generate-with-secrets-token-urlsafe
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
PASSWORD_PEPPER=change-me-random-pepper

COMPREFACE_BASE_URL=http://localhost:8000
COMPREFACE_API_KEY=replace-with-your-recognition-service-api-key
COMPREFACE_RECOGNITION_API_KEY=replace-with-your-recognition-service-api-key
ATTENDANCE_RECOGNITION_THRESHOLD=0.97
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_TEACHER_EMAIL_DOMAINS=hust.edu.vn

MAX_IMAGE_UPLOAD_MB=5
MAX_CSV_UPLOAD_MB=10
BACKUP_DIR=./backups
