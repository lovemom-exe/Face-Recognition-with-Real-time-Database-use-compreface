# SQLite local fallback
DATABASE_URL=sqlite:///backend_attendance.db

# PostgreSQL local via docker-compose.postgres.yml
# DATABASE_URL=postgresql+psycopg2://face_attendance:face_attendance_password@127.0.0.1:5432/face_attendance
# If local port 5432 is already used, set POSTGRES_PORT=55432 and use:
# DATABASE_URL=postgresql+psycopg2://face_attendance:face_attendance_password@127.0.0.1:55432/face_attendance

COMPREFACE_BASE_URL=http://localhost:8000
COMPREFACE_RECOGNITION_API_KEY=replace-with-your-recognition-service-api-key
ATTENDANCE_RECOGNITION_THRESHOLD=0.97
